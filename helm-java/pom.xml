<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.marcnuri.helm-java</groupId>
    <artifactId>helm-java-parent</artifactId>
    <version>0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>helm-java</artifactId>
  <name>Helm Java :: Helm</name>
  <description>
    Helm Java Client
  </description>

  <properties>
    <enforcer.skipRules>requireFilesExist</enforcer.skipRules>
    <!-- Helm cache and data used by the tests (see the surefire configuration) -->
    <helm.test.home>${project.build.directory}/helm-home</helm.test.home>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <KUBECONFIG>/dev/null</KUBECONFIG>
            <!-- Keep registry credentials, repositories and their cache out of the developer's Helm and Docker config.
                 The config homes are in the test output directory because they hold the seeded registry configs
                 (src/test/resources/helm-home), which IDEs copy there too. Without a seeded entry, Helm's registry
                 client (oras-go DetectDefaultNativeStore) would store logins in the OS credential store
                 (osxkeychain, wincred, pass, secretservice). -->
            <HELM_CACHE_HOME>${helm.test.home}/cache</HELM_CACHE_HOME>
            <HELM_CONFIG_HOME>${project.build.testOutputDirectory}/helm-home/config</HELM_CONFIG_HOME>
            <HELM_DATA_HOME>${helm.test.home}/data</HELM_DATA_HOME>
            <DOCKER_CONFIG>${project.build.testOutputDirectory}/helm-home/docker</DOCKER_CONFIG>
          </environmentVariables>
          <!-- Every HELM_* variable Helm reads that would redirect its files or change its behavior: those in
               helm.sh/helm/v3 pkg/cli/environment.go, plus HELM_DRIVER (read by native/internal/helm/helm.go) and
               HELM_DRIVER_SQL_CONNECTION_STRING (pkg/action/action.go); same list as native/internal/test/env.go -->
          <excludedEnvironmentVariables>
            <excludedEnvironmentVariable>HELM_BURST_LIMIT</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_DEBUG</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_DRIVER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_DRIVER_SQL_CONNECTION_STRING</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBEAPISERVER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBEASGROUPS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBEASUSER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBECAFILE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBECONTEXT</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBEINSECURE_SKIP_TLS_VERIFY</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBETLS_SERVER_NAME</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_KUBETOKEN</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_MAX_HISTORY</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_NAMESPACE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_PLUGINS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_QPS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_REGISTRY_CONFIG</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_REPOSITORY_CACHE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>HELM_REPOSITORY_CONFIG</excludedEnvironmentVariable>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>lib-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>com.dajudge.kindcontainer</groupId>
      <artifactId>kindcontainer</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>darwin-amd64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>darwin-amd64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>darwin-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>darwin-amd64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>darwin-arm64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>arm64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>darwin-arm64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>darwin-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>darwin-arm64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-amd64</id>
      <activation>
        <os>
          <family>unix</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>linux-amd64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-x86_64</id>
      <activation>
        <os>
          <family>unix</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>linux-amd64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-arm64</id>
      <activation>
        <os>
          <family>unix</family>
          <arch>arm64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>linux-arm64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-aarch64</id>
      <activation>
        <!-- Linux JVMs report aarch64; the name keeps Apple Silicon macOS (also family unix) out of this profile -->
        <os>
          <family>unix</family>
          <name>linux</name>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>linux-arm64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>windows-amd64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>windows-amd64</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>windows-amd64</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
